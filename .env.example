# --- App (Vite) — anon key only, safe for the browser ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Import script (never commit, never expose in frontend) ---
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: import into a NEW project while the app still points at the old one.
# If unset, import uses VITE_SUPABASE_URL (or SUPABASE_URL).
# SUPABASE_IMPORT_URL=https://NEW_PROJECT_REF.supabase.co

# Optional: export (npm run data:pull) from a specific project, e.g. legacy backup.
# If unset, export uses VITE_SUPABASE_URL.
# SUPABASE_EXPORT_URL=https://OLD_PROJECT_REF.supabase.co

# Workflow (new Supabase project):
# 1. Create project → SQL Editor → run schema.sql
# 2. Put NEW project URL in SUPABASE_IMPORT_URL and service_role in .env.local
# 3. npm run data:xlsx
# 4. npm run data:import -- enriched_elft_data_from_xlsx.json
# 5. When happy, set VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY to the NEW project and redeploy
